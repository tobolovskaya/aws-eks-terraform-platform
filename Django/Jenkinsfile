pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  # IRSA: this service account gets a short-lived role that can only push to our ECR repository
  serviceAccountName: jenkins-agent
  containers:
  # Kaniko builds images without a Docker daemon, docker.sock or privileged mode
  # (maintained fork of the archived GoogleContainerTools/kaniko)
  - name: kaniko
    image: ghcr.io/osscontainertools/kaniko:v1.28.0-alpine
    command:
    - cat
    tty: true
  - name: kubectl
    image: bitnami/kubectl:latest
    command:
    - cat
    tty: true
  - name: helm
    image: alpine/helm:latest
    command:
    - cat
    tty: true
"""
        }
    }
    
    environment {
        ECR_REGISTRY = "${ECR_REGISTRY_URL}"
        IMAGE_TAG = "${BUILD_NUMBER}"
        APP_NAME = "django-app"
        KUBECONFIG = credentials('kubeconfig')
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build and Push Image') {
            steps {
                container('kaniko') {
                    // Single quotes: the shell expands the variables, not Groovy (safer, no injection)
                    sh '''
                        /kaniko/executor \
                          --context "dir://${WORKSPACE}/Django" \
                          --dockerfile Dockerfile \
                          --destination "${ECR_REGISTRY}:${IMAGE_TAG}" \
                          --credential-helpers ecr
                    '''
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                container('helm') {
                    script {
                        sh """
                            helm upgrade --install ${APP_NAME} ./charts/django-app \\
                                --set image.repository=${ECR_REGISTRY} \\
                                --set image.tag=${IMAGE_TAG} \\
                                --set ingress.enabled=true \\
                                --set ingress.hosts[0].host=django-app.local \\
                                --namespace production \\
                                --create-namespace \\
                                --wait
                        """
                    }
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                container('kubectl') {
                    script {
                        sh """
                            kubectl get pods -n production -l app.kubernetes.io/name=django-app
                            kubectl rollout status deployment/${APP_NAME} -n production
                        """
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo "✅ Deployment successful! Application deployed with image tag: ${IMAGE_TAG}"
        }
        failure {
            echo "❌ Deployment failed! Check the logs for details."
        }
        always {
            cleanWs()
        }
    }
}